        #Covers dependency from sittingReview20260803a to timestampSettingsUx;
        // REVIEW — the per-sitting human gate (D0049) for 2026-08-03. HONESTLY PENDING the owner's on-device review of 1.12.7.
        // ===== Sprint settingsUxPolish (2026-08-03) — 1.12.8: little-X removes, a canonical collapsible
        // (setHeading + native chevron), Reconfigure/Disconnect moved up, brief store-password. =====
        action settingsUxPolish;
        verification settingsUxPolishDoD : Test { :>> id = "39ac7db8-6135-4b02-d8c4-27be15024cc6"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.12.8 (UX; client-only, NO server redeploy). Owner-directed follow-up (+ mobile screenshot): (1) replace the huge per-row 'Remove' buttons on the date-field / excluded-folder lists with a little X (Obsidian's canonical addExtraButton().setIcon('x')); the lists are easily restorable so no warning; (2) make the Timestamp-changes section COLLAPSIBLE + default-collapsed; (3) fix the synced-plugin list's ORPHANED raw <details>-triangle collapse — the owner directed 'research canonical ways ... don't reinvent'; RESEARCH (Obsidian dev docs + API via context7): NO native collapsible-group API (SettingGroup v1.11.0 has addClass/addExtraButton/addSearch/addSetting/setHeading — no collapse), and setHeading() is the documented canonical section header; so the collapsible() helper is built from Obsidian's OWN components — Setting().setHeading() made clickable + a native lucide chevron via setIcon() + a body toggle (no custom disclosure widget) — used for BOTH the plugin list and the Timestamp section; (4) move Reconfigure/Disconnect from Advanced into fillStatus (top Connection group); (5) cut the store-password description to one line. Guards: settings-ui.dom 'the Timestamp changes section is a collapsible (default collapsed) that toggles on header click' + the existing add/remove-list tests (the little-X extra-button clicks through); obsidian-stub gained ExtraButtonComponent + addExtraButton. DoD: full client vitest (576) + tsc clean + esbuild build clean + keel validate/guard green. Resolves issueSettingsUxPolish."; }
        part settingsUxPolishDoDR1 : TestResult { :>> id = "4abd8ec9-7246-4c13-e9d6-38cf26135de7"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "79c403c"; :>> judgedAt = "2026-08-03"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260803a to settingsUxPolish;
        // ===== Sprint collapseHeaderFix (2026-08-03) — 1.12.9: the 1.12.8 collapse header didn't render as a
        // heading (setHeading without setName); fix to the canonical setName().setHeading(). =====
        action collapseHeaderFix;
        verification collapseHeaderFixDoD : Test { :>> id = "5bce9fda-8357-4c24-e9e8-49df26146ea9"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.12.9 (UX; client-only, NO server redeploy). Owner-reported on 1.12.8 (screenshot): 'dropdown looks the same, not like a heading'. Cause: collapsible() called new Setting(c).setHeading() but built the label from a manual createSpan instead of setName(title), so Obsidian's heading styling (which targets .setting-item-name) never applied. FIX: use the canonical new Setting(c).setName(title).setHeading() (the documented section-heading), insert the native lucide chevron BEFORE the title (section-collapse convention), + a styles.css safety (.selfsync-collapse-header .setting-item-name { font-weight: 600 }) so it reads as a heading even on themes that render .setting-item-heading subtly. Guard: settings-ui.dom 'the Timestamp changes section is a collapsible (default collapsed) that toggles on header click' (header found by its heading TEXT + toggles). DoD: full client vitest (576) + tsc clean + esbuild build clean + keel validate/guard green. Resolves issueCollapseHeaderNotHeading."; }
        part collapseHeaderFixDoDR1 : TestResult { :>> id = "6cdf0aeb-9468-4d35-fae9-50ea37257fba"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "171160c"; :>> judgedAt = "2026-08-03"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260803a to collapseHeaderFix;
        // ===== Sprint collapseHeaderGroupFix (2026-08-03) — 1.12.10: the 1.12.9 setName().setHeading() fix
