        // ===== D0037 (1.13.0) — share-links canonical + link onboarding; admin console rework.
        // SERVER REDEPLOY required. Two phases, both delivered @bc11f9c. =====
        action shareLinksCanonical;
        verification shareLinksCanonicalDoD : Test { :>> id = "a1b2c3d4-0037-4a10-9b20-d0037c0de001"; :>> method = VerificationMethod::test; :>> procedureText = "Ships part of MINOR 1.13.0 (D0037; SERVER IMAGE REDEPLOY required — server behavior changes). Phase 1 (admin console + server): retire the grantee-username grant path — remove POST /api/admin/shares (share_create) + GET /api/admin/usernames (its only consumer); KEEP DELETE /api/admin/shares (grant revoke — a redeemed link mints the same D0008 grant). Admin console (admin_ui.html): a SINGLE Sharing section (not per-vault) — vault dropdown + permission -> a copyable selfsync-share:// link whose server address is an EDITABLE field defaulting to location.origin (correct for split/proxied deploys, per critique); active (unredeemed) links + redeemed grants each revocable; registration open/closed is a real toggle switch (was a checkbox); each vault shows last_used (newest .sync-index.db server-side mtime, computed in spawn_blocking, no schema migration). Guards: server cargo test (admin 33 incl. owner_grants_and_revokes now via a redeemed link + owner_share_endpoints_reachable_on_public_surface) + clippy -D warnings + client vitest 577 + tsc clean. Realizes D0037."; }
        part shareLinksCanonicalDoDR1 : TestResult { :>> id = "a1b2c3d4-0037-4a10-9b20-d0037c0de002"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "bc11f9c"; :>> judgedAt = "2026-08-03"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260803a to shareLinksCanonical;
        action shareLinkOnboarding;
        verification shareLinkOnboardingDoD : Test { :>> id = "a1b2c3d4-0037-4a10-9b20-d0037c0de003"; :>> method = VerificationMethod::test; :>> procedureText = "Ships part of MINOR 1.13.0 (D0037). Phase 2 (link onboarding — server + plugin): new PUBLIC POST /api/share-redeem-register { token, username, password } creates a brand-new account authorized BY a valid vault share link (link-as-invite — works even under CLOSED registration), CLAIM-FIRST so a username collision is one-shot (anti-enumeration parity with a closed-reg invite) and a crash leaves no orphan account, rolling back BOTH the link claim and the just-created account on cap/grant failure (rollback failures logged, not swallowed), returning a session token. The plugin setup wizard's redeem-mode 'Create account' routes through transport.redeemRegister so a new user onboards straight from a share link; the plugin's grantee-username share UI (ShareManageModal add-a-grant, plugin.shareVault, transport.shareCreate) is removed (grant revoke kept). An INDEPENDENT security/correctness critique was run on the auth path; its three Medium findings (link-holder username-enumeration oracle, fire-and-forget rollback orphan, location.origin link) were all fixed and covered by tests. Guards: 3 sharing E2E through the REAL server incl. 'a new account redeems a share LINK to onboard (link-as-invite) under closed registration' + share_redeem_register_onboards_* / _rejects_bad_token_and_collisions (one-shot) server tests + clippy -D warnings + client vitest 577 + tsc clean. Realizes D0037."; }
        part shareLinkOnboardingDoDR1 : TestResult { :>> id = "a1b2c3d4-0037-4a10-9b20-d0037c0de004"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "bc11f9c"; :>> judgedAt = "2026-08-03"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260803a to shareLinkOnboarding;
        // ===== D0037 completion + a test-reliability fix (1.14.0). =====
        action accountCreationLink;
        verification accountCreationLinkDoD : Test { :>> id = "a1b2c3d4-0037-4a10-9b20-d0037c0de005"; :>> method = VerificationMethod::test; :>> procedureText = "Completes D0037's account-creation link (MINOR 1.14.0; SERVER REDEPLOY for the admin-console part). The owner's model distinguished the vault share link (account+share) from a standalone account-creation link that 'just makes the first step' (an account, no vault) — this delivers the latter. New client codec invitelink.ts (selfsync-invite://register?server=&token=, mobile-safe like the share-link codec); the setup wizard recognizes a pasted invite link (prefills server + invite token + register mode) and THREADS the token through HttpTransport.register so account creation works on a CLOSED server (WizardState gains `invite`); the admin console (admin_ui.html renderInvites) surfaces each issued invite as a copyable account-creation LINK with an EDITABLE server address (parity with share links, correct for split/proxied deploys) plus the raw token for manual entry. Guards: client vitest — invitelink.test.ts (codec encode/parse/reject/mobile-percent-encoding) + modals-ui.dom 'pasting an account-creation (invite) link prefills the server + registers WITH the invite token' (asserts register called with the token); server register-with-invite already covered (admin_sets_registration_and_issues_working_invite). Full client vitest + tsc + build clean. Realizes D0037."; }
        part accountCreationLinkDoDR1 : TestResult { :>> id = "a1b2c3d4-0037-4a10-9b20-d0037c0de006"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3585b23"; :>> judgedAt = "2026-08-03"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260803a to accountCreationLink;
        action pluginWiringTimerLeakFix;
        verification pluginWiringTimerLeakFixDoD : Test { :>> id = "a1b2c3d4-0047-4a10-9b20-d0047c0de007"; :>> method = VerificationMethod::test; :>> procedureText = "Fixes the intermittent plugin-wiring flake (issuePluginWiringTimerLeak; ships with 1.14.0, client-test-only). A leaked reconnect-backoff setTimeout / poll setInterval from one test fired during a LATER test (real Node timers persist across tests) and re-stamped baseVaultKey mid-assertion, so 'D0047 guard is SERVER-qualified' failed ~1 in 3 full runs. FIX (D0047 — a correction becomes a permanent guard): plugin-wiring.test.ts now TRACKS every window timer a test schedules and force-clears all live ones in afterEach, guaranteeing timer isolation regardless of whether each onunload path cleared its own timers. Verified by THREE consecutive full client vitest runs green (the flake could no longer reproduce). Resolves issuePluginWiringTimerLeak."; }
        part pluginWiringTimerLeakFixDoDR1 : TestResult { :>> id = "a1b2c3d4-0047-4a10-9b20-d0047c0de008"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3585b23"; :>> judgedAt = "2026-08-03"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260803a to pluginWiringTimerLeakFix;
