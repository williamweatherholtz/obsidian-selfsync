        part deliverableTestGateDoDR19 : TestResult { :>> id = "83552f8c-a268-4a0b-b633-cdb198a55ab9"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f96b217"; :>> judgedAt = "2026-07-19"; :>> judgedBy = "claudeOpus"; }
        part deliverableTestGateDoDR20 : TestResult { :>> id = "4a0655a3-654f-44b3-ada4-084d44b171a5"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "18f9cc2"; :>> judgedAt = "2026-07-28"; :>> judgedBy = "claudeOpus"; }
        part deliverableTestGateDoDR21 : TestResult { :>> id = "1b0207a4-2f54-4ace-b7e4-5cf8db49998a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "6c33630"; :>> judgedAt = "2026-07-29"; :>> judgedBy = "claudeOpus"; }
        part deliverableTestGateDoDR22 : TestResult { :>> id = "d2f8343d-fd35-485c-8606-a7e00bde94f8"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3b4a55e"; :>> judgedAt = "2026-07-29"; :>> judgedBy = "claudeOpus"; }
