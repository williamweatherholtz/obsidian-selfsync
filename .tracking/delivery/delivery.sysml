        action pluginSyncDisplayName;
        verification pluginSyncDisplayNameDoD : Test { :>> id = "d7c19008-0000-4a10-9b20-a1b2c3d40098"; :>> method = VerificationMethod::test; :>> procedureText = "Ships 1.9.3. A synced-but-not-yet-loaded plugin shows its real display name, not the folder id. Simpler than a server fetch (the original idea): an ADOPTED plugin's manifest.json is already synced to LOCAL disk, so getPluginDisplayName reads the 'name' from .obsidian/plugins/<id>/manifest.json (cached; async, re-renders on resolve) — the settings row + sort fall back manifests[id]?.name || getPluginDisplayName(id) || id. A truly not-adopted server-only id (the 'Available' group) keeps the honest folder id. DoD: full client vitest + tsc + keel green. Resolves issuePluginSyncFolderIdNotName."; }
        part pluginSyncDisplayNameDoDR1 : TestResult { :>> id = "d7c1a00f-0000-4a10-9b20-a1b2c3d4a00f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "969f779"; :>> judgedAt = "2026-07-31"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260731 to pluginSyncDisplayName;
        // ===== Sprint vaultChangeTransitionGuard (2026-07-31) — 1.9.2: close the vault-change-skips-transition
        // data-integrity gap. =====
        action vaultChangeTransitionGuard;
        verification vaultChangeTransitionGuardDoD : Test { :>> id = "d7c19009-0000-4a10-9b20-a1b2c3d40099"; :>> method = VerificationMethod::test; :>> procedureText = "Ships 1.9.2 (data-integrity). A vault change no longer reconciles against a STALE base (which could silently overwrite local files via decide()'s B===L->pull branch, no conflict-copy). SetupWizardModal.finish() routes a vault CHANGE (vaultId differs AND local data present) through switchToVault('merge') — pendingSwitch -> switchTo clears the stale base + unions (the safe default, nothing lost) — instead of a silent reconnect. Defense-in-depth GUARD (D0047): the persisted base is stamped with its owner/vaultId (settings.baseVaultKey) after each successful connect, and doConnect forces a safe merge-switch whenever the live vault doesn't match that stamp — so ANY future path that changes the vault without switchTo can't silently overwrite. Guard test: plugin-wiring.test 'a FOREIGN base forces a safe merge-switch'. DoD: full client vitest (525) + tsc --noEmit clean + keel green. Resolves issueVaultChangeSkipsTransition."; }
        part vaultChangeTransitionGuardDoDR1 : TestResult { :>> id = "d7c1a00b-0000-4a10-9b20-a1b2c3d4a00b"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e0a4422"; :>> judgedAt = "2026-07-31"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260731 to vaultChangeTransitionGuard;
        // ===== Sprint sessionIdleReloginEase (2026-07-31) — 1.9.2: make the idle-logout non-surprising. =====
        action sessionIdleReloginEase;
        verification sessionIdleReloginEaseDoD : Test { :>> id = "d7c1900a-0000-4a10-9b20-a1b2c3d4009a"; :>> method = VerificationMethod::test; :>> procedureText = "Ships 1.9.2 (UX; the behavior is WORKING-AS-DESIGNED — token-only default IA.3.5.10 + idle timeout AC.3.1.11). The idle-logout is no longer a silent surprise: the connection FSM (connectionFsmTypedFailure) surfaces the reason as blocked{sessionExpired} → 'Session expired — open Settings → Reconfigure' on the status card + light (not just an opened modal), and the 'Store password on this device' setting hint documents the friction knob (it enables silent reconnect past the idle window) + names SESSION_IDLE_TIMEOUT_SECS for admins. The optional longer default idle window is server-config tuning left to the operator. Resolves issueSessionIdleReloginFriction."; }
        part sessionIdleReloginEaseDoDR1 : TestResult { :>> id = "d7c1a00c-0000-4a10-9b20-a1b2c3d4a00c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e0a4422"; :>> judgedAt = "2026-07-31"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260731 to sessionIdleReloginEase;
        // ===== Sprint connectionFsmTypedFailure (2026-07-30) — 1.9.1: give the connection lifecycle's FAILURE
        // EDGE a type. A hard auth rejection was retried forever like a network drop (self-lockout via the
        // server throttle + an "offline" mislabel). Owner-directed FSM redesign, spec + independent critique:
        // docs/superpowers/specs/2026-07-30-connection-fsm-typed-failure-design.md. =====
        action connectionFsmTypedFailure;
        verification connectionFsmTypedFailureDoD : Test { :>> id = "d7c1900b-0000-4a10-9b20-a1b2c3d4009b"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.9.1. The connection lifecycle is TWO cooperating single-concern FSMs (owner's 'multi FSMs, one per concern' steer): the operational work-queue EngineState (unchanged; 'offline' renamed 'disconnected') + a NEW instance-scoped LinkState machine (ok/retrying/blocked) in connstate.ts, driven by a pure classifyConnectError (reads ONLY tagged error fields — status/retryAfter/wasLogin/endpoint minted by transport, never a message regex) + a pure recoveryFor. The FSM ALPHABET is enums in one spot (FailureKind/RecoveryKind/LinkKind/LinkEventKind/Endpoint/SyntheticKind — owner's 'reference an enum, not hardcoded strings' steer). Behaviour, per the critique-corrected table (avoids BOTH strand and loop): a 401-login → blocked{authRejected} (STOP hammering, await user) with a ~10min self-heal re-probe; 429 → the server's Retry-After window; a chunk/meta 404 stays transient (never mis-tagged vaultGone → no strand); a vault-scope 404 → blocked{vaultGone}; version mismatch/degraded → typed synthetic; residual-unknown → bounded slow retry; isAuthError FIXED to read the status field (the /HTTP 401/ regex never matched the server's 'unauthorized' body — the loop's root cause). Distinct status labels replace the single 'offline'. vaultGone/lastIssue re-pointed at the LinkState (no dual source). Guard (D0047): connstate.test (19: classify table + strand/loop invariants) + syncengine.test (LinkState integration). DoD: full client vitest (525) + tsc --noEmit clean + keel green. Server untouched. Resolves issueAuthRetryStormNoStop."; }
        part connectionFsmTypedFailureDoDR1 : TestResult { :>> id = "d7c1a00a-0000-4a10-9b20-a1b2c3d4a00a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "93bfdc4"; :>> judgedAt = "2026-07-30"; :>> judgedBy = "claudeOpus"; }
        // CLOSEOUT (autonomous, inspect): shipped 1.9.1; client vitest 525 + tsc clean + keel green. RETRO
        // (analysis): the failure edge was UNTYPED — one 'offline' bucket + one retry-forever recovery — so a
        // hard auth failure looped and self-locked. An independent critique of the FIRST design caught that the
        // naive fix would be WORSE (strand the user on a mid-deploy 401 / a transient chunk-404), and that
        // isAuthError was already broken — critique-before-implement paid off a FIFTH time. Durable lesson +
        // guard: classify reads TYPED fields never a message regex; unknown ⇒ bounded slow retry; every blocked
        // class self-heals. Owner-shaped: two FSMs (not one enum), the alphabet as enums in one spot.
        #Covers dependency from sittingReview20260730 to connectionFsmTypedFailure;
        // ===== Sprint hotLoadSyncedPlugins (2026-07-31) — 1.11.0: activate a newly-synced plugin WITHOUT a
        // restart, on a provably-private vault only. A SECURITY-scoped, owner-accepted exception to the
        // Round-6-SEC 'never auto-execute sync-delivered config' gate. =====
        action hotLoadSyncedPlugins;
        verification hotLoadSyncedPluginsDoD : Test { :>> id = "d7c19010-0000-4a10-9b20-a1b2c3d400a0"; :>> method = VerificationMethod::test; :>> procedureText = "Ships MINOR 1.11.0. A community plugin newly synced to a device is activated LIVE (Obsidian's internal app.plugins.loadManifests + enablePlugin) — no restart — instead of the 'restart to activate' banner. SECURITY-SCOPED: a NARROW, owner-ACCEPTED exception to the Round-6-SEC 'never auto-execute sync-delivered config' gate. It fires ONLY on a PROVABLY-PRIVATE vault: OUR OWN (not shared TO us) AND with NO readWrite grant or share-link to anyone (refreshVaultPrivacy — FAIL-SAFE: any doubt/error => NOT private => restart barrier stays; refreshed on connect + on every share change). A shared/shareable vault (a peer could push malicious main.js = RCE into Obsidian's un-CSP'd renderer), an UPDATE to an already-running plugin (Obsidian re-executes plugin code only on reload), a hot-load FAILURE, and CSS all KEEP the restart trust-barrier. Best-effort: a plugin that refuses to hot-load falls back to restart, never breaks sync. PROVENANCE: the owner was shown the RCE tradeoff explicitly (the never-auto-execute gate + the shared-vault threat) and CHOSE the 'own, unshared vault only' scope over 'all vaults (reverse the gate)' / 'keep the restart gate' — a genuine INFORMED security decision. Guard: plugin-wiring 'refreshVaultPrivacy fail-safe' + 'hot-load: newly-synced on a private vault activates live; running-update/shared keeps the restart barrier'. DoD: full client vitest + tsc + keel green. Resolves issueSyncedPluginRestart."; }
        part hotLoadSyncedPluginsDoDR1 : TestResult { :>> id = "d7c1a011-0000-4a10-9b20-a1b2c3d4a011"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1283e03"; :>> judgedAt = "2026-07-31"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260731 to hotLoadSyncedPlugins;
        // REVIEW — the per-sitting human gate (D0049) for the 2026-07-31 sitting.
        verification sittingReview20260731 : Test { :>> id = "d7c1a00d-0000-4a10-9b20-a1b2c3d4a00d"; :>> method = VerificationMethod::confirmation; :>> procedureText = "Per-sitting human review (D0049) for the 2026-07-31 sitting: wweatherholtz directed 'proceed with all others' (the four investigated field defects), thereby accepting the completed work + its 1.9.2 release: the vault-change-transition data-integrity guard (vaultChangeTransitionGuard), the idle-relogin UX (sessionIdleReloginEase), the plugin-list parity UI split (under pluginSyncRemovalPropagation), and — on the follow-up 'continue' directives — the plugin display-name fix (pluginSyncDisplayName, 1.9.3, read from the synced local manifest) and the plugin display-name fix. CORRECTION (2026-07-31): this confirmation covers ONLY what the owner actually directed — the parity RESOLUTION (via 'proceed with all others' / 'continue'). The specific 'remove from server' PURGE mechanism (pluginSyncRemovalPropagation, 1.10.0) was AI-PROPOSED, not owner-chosen; the owner stated they did not explicitly choose it. After the correction + an explicit keep-vs-revert offer, the owner chose to KEEP it ('#2 keep in') — so it is an AI-initiated but owner-ACCEPTED kept feature; this attestation records that accurate provenance, not the retracted 'owner chose to build it' framing. SEPARATELY the owner asked to activate newly-synced plugins WITHOUT a restart; when shown that this collides with the Round-6-SEC never-auto-execute gate (a shared-vault peer could push malicious plugin code = RCE), the owner made an INFORMED choice of the 'own, unshared vault only' scope (over reversing the gate / keeping it) and directed 'yes please' — accepting hotLoadSyncedPlugins (1.11.0) at that scope. Single human confirmation gate for the owner-directed work; closeOut/retro autonomous."; }
        part sittingReview20260731R1 : TestResult { :>> id = "d7c1a00e-0000-4a10-9b20-a1b2c3d4a00e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e0a4422"; :>> judgedAt = "2026-07-31"; :>> judgedBy = "wweatherholtz"; }
        // ===== Sitting 2026-08-01 — the owner asked 'any outstanding items? let's do a critique pass'. A
        // 4-critic INDEPENDENT antagonistic pass over the 1.9.0-1.11.0 shipped code (data-integrity / FSM /
        // security / vault lenses) surfaced 3 verified HIGH defects; each finding was re-verified against the
        // code by the reviewer before recording (critic proposes, code decides). Owner directed 'fix all 3
        // HIGHs now'; each fixed TDD and shipped in PATCH 1.11.1. Lower-severity findings recorded as backlog
        // Issues (issues.sysml). closeOut (inspect)/retro (analysis) autonomous; sitting review is the human gate. =====
        // Sprint hotLoadPrivacyGateFreshCheck (1.11.1) — SECURITY: close the hot-load RCE-gate bypass.
        action hotLoadPrivacyGateFreshCheck;
        verification hotLoadPrivacyGateFreshCheckDoD : Test { :>> id = "7b078947-1ce3-405e-8ce5-3615b7c3606d"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.1 (security). The 1.11.0 hot-load gate rode a STALE vaultIsPrivate: never reset on a vault switch; flushConfigReload (which hot-loads) ran BEFORE the connect-time refreshVaultPrivacy (itself fire-and-forget `void`); and the delta/poll path that also hot-loads never refreshed it. Net RCE-barrier (R14 sec#1) bypass: a private->shared vault switch, or an out-of-band readWrite grant on your own vault, left the gate true -> a peer's synced main.js auto-executes with NO restart. Fix: applyPluginCodeChange re-derives privacy FRESH at the decision point (awaited refreshVaultPrivacy, only when a plugin actually ARRIVED - rare), so the gate is current on EVERY entry path (connect ordering + delta staleness + switch staleness all closed); a shared/shareable vault or any error fails safe to NOT-private. Guard: plugin-wiring 'hot-load re-checks privacy FRESH — a stale-true vaultIsPrivate does NOT auto-execute a now-shared vault's plugin (RCE gate)' + the updated 'newly-synced on a private vault activates live' (now driven by the fresh source). DoD: full client vitest (531) + tsc --noEmit clean + keel green. Resolves issueHotLoadPrivacyGateStale (critique-found, HIGH)."; }
        part hotLoadPrivacyGateFreshCheckDoDR1 : TestResult { :>> id = "7e00be74-ffe8-4486-8e13-718200954a32"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "98a44a3"; :>> judgedAt = "2026-08-01"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260801 to hotLoadPrivacyGateFreshCheck;
        // Sprint reconcilePathReloginOnce (1.11.1) — FSM: a mid-session token expiry self-heals, no false block.
        action reconcilePathReloginOnce;
        verification reconcilePathReloginOnceDoD : Test { :>> id = "81ce40db-cf15-4d2f-9a03-9b13850bc535"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.1 (FSM/UX). A routine token expiry DURING a connected session used to mis-classify as a PERMANENT auth block: the reconcile effects (doReconcileAll/doReconcilePath) hit the API directly, unlike doConnect which re-logs-in once on a 401 — so a poll-path 401 went straight to classify -> blocked{authRejected} ('Sign-in rejected — check your password') for up to the 600s self-heal reprobe, and PERMANENTLY on a WS-less mobile client. The inverse of the auth-storm connectionFsmTypedFailure fixed. Fix: withSyncRelogin wraps the reconcile effects — on a 401, IF a password is stored, one silent re-login (freshLogin, rebuild the api) + a single retry; a second 401, or NO stored password (token-only), propagates to classify -> the correct blocked/re-auth state. Guard: plugin-wiring 'mid-session token expiry on the poll path silently re-logs-in ONCE (no false auth block)'. DoD: full client vitest (531) + tsc clean + keel green. Resolves issueReconcilePathTokenExpiryBlock (critique-found, HIGH)."; }
        part reconcilePathReloginOnceDoDR1 : TestResult { :>> id = "68275e7c-028c-40cd-a9b4-0c6fd7cd985d"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "98a44a3"; :>> judgedAt = "2026-08-01"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260801 to reconcilePathReloginOnce;
        // Sprint vaultKeyServerQualified (1.11.1) — DATA: server-qualify the vault-identity key.
        action vaultKeyServerQualified;
        verification vaultKeyServerQualifiedDoD : Test { :>> id = "7b975432-83a4-4fb3-82e0-6218735d91d2"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.1 (data-integrity). The D0047 vault-change guard's identity key was SERVER-BLIND (historyFloorKey = owner/vault) and so was the setup wizard's vaultChanged check — so repointing this device at a DIFFERENT server that hosts the SAME vault name (e.g. 'notes', 'obsidian' — two servers trivially collide on owner=''/vault) never tripped the guard: a plain reconcile ran against a FOREIGN base and could silently overwrite local files (decide()'s B===L->pull, no conflict-copy). Fix: a new server-qualified vaultIdentityKey (`host|owner/vault`, host from URL.host; `|` occurs in neither a host nor a vault name) backs the guard + the baseVaultKey stamp; the wizard's vaultChanged now also compares serverUrl. An OLD server-blind stored key (no `|`) is GRANDFATHERED to the current server so an upgrade doesn't force a spurious merge for existing users; a genuine later server/vault/owner change still trips. Guards: plugin-wiring 'D0047 guard is SERVER-qualified: a different server with the same vault name is a different vault' + 'grandfathers an old server-blind base key' + the updated foreign-base test. DoD: full client vitest (531) + tsc clean + keel green. Resolves issueVaultKeyServerBlind (critique-found, HIGH)."; }
        part vaultKeyServerQualifiedDoDR1 : TestResult { :>> id = "fadb9c91-8c77-41db-a4a3-dd70ab37eea4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "98a44a3"; :>> judgedAt = "2026-08-01"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260801 to vaultKeyServerQualified;
        // ===== Backlog resolver stubs (recorded critique findings, NOT started) — one per critic area; each
        // DoD describes the fix, no R1 yet. They triage the backlog Issues (D0077) so resolution stays computed. =====
        action critiqueBacklogFsm;
        verification critiqueBacklogFsmDoD : Test { :>> id = "70cf3431-9e45-4a05-a840-6b0de039e020"; :>> method = VerificationMethod::test; :>> procedureText = "DONE (1.11.2 @4b88886). FIXED: F2 disconnect/unload reset LinkState + clear lastIssue (test 'disconnect resets LinkState'); F3 the synthetic serverDegraded reindex message is no longer clobbered by the generic catch (test 'a serverDegraded message survives the generic catch'); F5 the dead UserRetry edge removed. NOT-CHANGED (justified): F4 — classify already pins the server's REAL 'mfa required'/'password change' phrasings (connstate.test) + must-change is handled via the login flag, so no rewrite needed (the plugin's lack of a TOTP field is a separate FEATURE gap, logged as issueMfaLoginUnsupported); the F5 429 re-arm / 503 retry-after nuances are bounded (our server sends sane windows) and left as-is. Original findings: (F2, MED) disconnect/unload don't reset LinkState, so getLastIssue/isVaultGone leak a stale blocked/vault-gone prompt after the user disconnects — reset link=LINK_OK in the disconnect/unload handlers. (F3, MED) the actionable serverDegraded 'run reindex' message set in doConnect is CLOBBERED by the generic outer catch (lastIssue = 'Can't reach the server…'), and ServerDegraded->Retrying{Slow} then shows generic 'Reconnecting…' — don't overwrite a synthetic's lastIssue. (F4, MED) MFA / must-change-password classification matches on UN-PINNED server body strings (the anti-pattern the FSM otherwise forbids) — pin the server phrasing or carry a typed reason. (F5, LOW) the UserRetry LinkState edge is dead (never dispatched); a repeated 429 re-arms retryAfter each cycle vs the spec's 'one retry'; Retry-After is honored only for 429 (503 uses a fixed 60s). Resolves issueFsmCritiqueBacklog."; }
        part critiqueBacklogFsmDoDR1 : TestResult { :>> id = "a4033440-ae53-4e15-854f-9b8194e873c4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "4b88886"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to critiqueBacklogFsm;
        action critiqueBacklogTimestamp;
        verification critiqueBacklogTimestampDoD : Test { :>> id = "cda4cdb2-a1fb-427d-ae1b-ef038b7a8719"; :>> method = VerificationMethod::test; :>> procedureText = "DONE (1.11.2 @4b88886). FIXED: T1/T2 the value-shape gate is now a PORTABLE ISO date/datetime regex (isTimestampValue), NOT Date.parse — a bare-year `created: 2020`/counter is no longer masked (it syncs, matching the UI promise), and identity is stable across desktop V8 / mobile JSCore (tests 'isTimestampValue: ISO shapes only' + 'a BARE-YEAR created edit is NOT masked'); T4 normalizedContent strips ALL trailing newlines + normalizes a lone CR to match merge3's sameIgnoringEol exactly (test 'a lone-CR and a final-newline TOGGLE are non-differences'). ACCEPTED (documented, LOW): T3 normHash-never-persisted / >1MiB gap — the base.text recompute covers the common <=1MiB case; persisting it for streamed large files isn't worth a LOW finding (already documented in baseNormHash). Original findings: (T1, MED) the value-shape gate is Date.parse-based, so a bare-year `created: 2020` (or a manually-curated date) is masked -> editing it silently doesn't propagate, contradicting the settings UI's 'a non-date value under the same key still syncs' — tighten the gate to a portable date-shape regex + reconcile the UI copy. (T2, MED) identity leans on Date.parse (engine-defined), so a non-canonical timestamp value hashes differently on desktop V8 vs mobile JSCore -> cross-platform churn — use a portable parser. (T4, LOW/MED) trailing-newline normalization is inconsistent: normalizedContent collapses 2+ -> 1 (keeps 0-vs-1 distinct) while merge3's sameIgnoringEol strips all -> a final-newline toggle churns on the push path but not the merge path; lone-CR (old-Mac) isn't normalized either. (T3, LOW) normHash is declared/serialized/read but NEVER written -> the override rides on base.text recompute; a >1MiB/text-less base has no identity (documented-accepted, churn+resurrection for large files only). Resolves issueTimestampGateCritiqueBacklog."; }
        part critiqueBacklogTimestampDoDR1 : TestResult { :>> id = "72d1ca51-6fc3-4a71-b492-097c122046a5"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "4b88886"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to critiqueBacklogTimestamp;
        action critiqueBacklogVault;
        verification critiqueBacklogVaultDoD : Test { :>> id = "577e534c-a351-46a3-ae0c-cc4b2b44a4a0"; :>> method = VerificationMethod::test; :>> procedureText = "DONE (1.11.2 @4b88886). FIXED: V2 — the D0047 guard's auto-merge now shows a user Notice (no longer SILENT), and redeeming a share on a device with local data routes through switchToVault('merge') (like the wizard's finish()) instead of a silent reconnect against a foreign base (setupwizard finishRedeem). ACCEPTED (LOW): V3 — the empty-base case has NO overwrite risk (no foreign base entries to trigger decide()'s pull; the local push-up is the broader resolution-modal UX question, not a data-loss bug), and the baseVaultKey fire-and-forget stamp is idempotent/self-healing. A full per-perm Download/Upload/Cancel modal on the guard path stays a possible future UX enhancement (the safe merge + notice is non-destructive meanwhile). Original findings: (V2, MED) the setup wizard's finishRedeem + the direct-adopt path route a redeem / an owner-axis change through reconnect() with NO resolution modal (only the vaultId-name axis was closed), relying on the silent guard; and the guard's own remedy is a SILENT merge (a union = cross-vault contamination), not the Download/Upload/Cancel adjudication modal SwitchVaultModal offers — route guard-detected changes through the same modal. (V3, LOW) the guard requires base.paths().length, so a vault change with an empty base but local files skips it (pushes local into the new vault); baseVaultKey is stamped via a fire-and-forget save (a crash re-fires a redundant merge). Resolves issueVaultTransitionModalBacklog."; }
        part critiqueBacklogVaultDoDR1 : TestResult { :>> id = "ba43bafd-b7c0-4049-b9d8-11d330224e05"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "4b88886"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to critiqueBacklogVault;
        action critiqueBacklogSecurity;
        verification critiqueBacklogSecurityDoD : Test { :>> id = "e188c851-5285-4dec-ae5c-acacda3c7536"; :>> method = VerificationMethod::test; :>> procedureText = "DONE (1.11.2 @4b88886). FIXED: S3 — removePluginFromServer now validates the plugin id against /^[A-Za-z0-9][A-Za-z0-9._-]*$/ (rejects `..`/slash/empty) BEFORE it builds the delete prefix, so a server/peer-influenced id can't widen the deletion beyond one plugin folder (test 'removePluginFromServer REJECTS a traversal / malformed plugin id'). S2 — OWNER DECISION (recorded, not code): shown the malicious-server threat (the gate trusts server-reported share metadata, and that same server ships the plugin bytes), the owner chose ACCEPT-RISK via the question 'How should we treat that?' -> 'Accept the risk (trust your server)'. Rationale (owner-endorsed): a compromised server already controls the plugin bytes it delivers, so trusting its share-metadata adds NO new exposure; the self-hosted single-user server is in the trust boundary. The private-vault hot-load exception stands as-is. The S3 re-push-re-hot-loads note is documented-accepted (on a private vault, re-activating your OWN re-pushed code needs no re-approval by design). Original findings: (S2, MED — threat-model decision) the hot-load privacy gate derives vaultIsPrivate from share metadata the SERVER reports; a COMPROMISED server (which also ships the plugin bytes) could lie 'not shared' -> hot-load. In scope only if the self-hosted server is treated as untrusted — needs an owner decision (accept-risk vs client-side attestation vs revert the hot-load exception). (S3, LOW) removePluginFromServer(id) builds a delete prefix from a server/peer-influenced id without validating it (reject `..`/`/`/empty); and a removed plugin re-pushed by another active device re-arrives and, on a private vault, hot-loads again without re-approval (allowlist desync). Resolves issueSecurityHardeningBacklog."; }
        part critiqueBacklogSecurityDoDR1 : TestResult { :>> id = "ffb9caa4-d246-4ae3-9775-1d8ab546367d"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "4b88886"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to critiqueBacklogSecurity;
        // ===== Sprint statusDisplayPureProjection (2026-08-02) — 1.11.3: FIELD BUG. The mobile status card
        // latched "Switching vault… applying your choice" on a persisted pendingSwitch even while synced. =====
        action statusDisplayPureProjection;
        verification statusDisplayPureProjectionDoD : Test { :>> id = "e113e917-9cc3-4390-ab54-60fe37171b63"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.3. Owner-reported on mobile: the status card showed 'Switching vault… applying your choice' PERSISTENTLY while connected + synced, with no switch initiated. Root cause: statusDisplay() reached AROUND the pure Phase projection to read settings.pendingSwitch (a persisted CONFIG value) + this.resuming (a loose flag) — neither is an FSM state — so a pendingSwitch that lingered set (its switchTo reconcile killed mid-flight on mobile before it cleared) latched the label. The D0047 guard was NOT the trigger (no 'base belonged to' line in the owner's shared debug log). Spec: docs/superpowers/specs/2026-08-02-status-display-pure-projection-design.md; independent antagonistic critique before ship. FIX: statusDisplay is now a PURE projection of Phase (+ syncPending/realtimeConnected/vaultReadOnly), reading no setting/flag — a switch/resume is a TRANSIENT shown as the normal connecting/syncing/idle projection, so a stale setting can never latch a label; the `resuming` field + isResuming() are deleted (display-only, now dead). CRITIQUE-HARDENED: (HIGH) an ALREADY-APPLIED guard clears a lingering AUTHORITATIVE switch (download/upload) whose base already belongs to the target vault — preventing a per-connect RE-CLOBBER of local edits (a not-yet-applied switch still replays, preserving R12-CA1; merge is idempotent); (MEDIUM) the settings-card dot now passes realtimeConnected into light() like the ribbon (no green-dot-over-polling divergence). Copy: '.obsidian file(s) in scope' -> 'syncing N Obsidian settings file(s)'. Guards: plugin-wiring 'statusDisplay … a PURE projection (no setting/flag can latch a label)' + 'a lingering already-applied authoritative switch is cleared, NOT re-run'. DoD: full client vitest (536) + tsc --noEmit clean + keel green. Resolves issueStatusSwitchingLatched."; }
        part statusDisplayPureProjectionDoDR1 : TestResult { :>> id = "6f4992b2-ebe2-40e8-a07c-1eb1c63f0f60"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "6183b5c"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to statusDisplayPureProjection;
        // ===== Sprint switchAbortOnOutage (2026-08-02) — 1.11.4: FIELD BUG surfaced by the owner's 1.11.3 log.
        // A vault switch swallowed a whole-server outage as per-file skips → a FALSE "Synced (polling)". =====
        action switchAbortOnOutage;
        verification switchAbortOnOutageDoD : Test { :>> id = "23ceec46-8334-4b63-b3d7-4055677e0f47"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.4. Owner's 1.11.3 debug log (mobile): a persisted 'upload' switch ran during a DNS outage and logged a FLOOD of per-file 'UnknownHostException: Unable to resolve host notes2… — skipped it, other files continue', then the card settled to a FALSE 'Synced (polling)' (yellow) while the server was actually unreachable. Root cause: the normal reconcile loops abort a pass on a connection-level error (isConnectionError -> throw -> engine offline+backoff ONCE), but switchTo's helpers (switchDownload/switchUpload) did NOT — every server-op catch went straight to onFileError (skip+continue). So a whole-server outage (DNS unresolvable, hits EVERY file identically) was swallowed file-by-file, the switch 'completed' with everything skipped, and the engine settled to idle -> the STATUS LIED 'synced' when it couldn't reach the server at all. FIX: switchDownload (applyPull) + switchUpload (pushFile, deleteFile) check isConnectionError first and re-throw, mirroring reconcileAll -> a DNS/host-unreachable outage aborts the switch -> engine disconnected -> 'Reconnecting…' (honest), no per-file skip flood; the local io.remove (not a server op) stays isolated; merge already routed through reconcileAll (covered). Side effect: the stuck 'upload' now aborts cleanly and completes+clears once the network returns instead of looping on skips. Guards: reconcile.test 'upload ABORTS on a whole-server outage (DNS)' + 'download ABORTS on a whole-server outage (DNS)'. DoD: full client vitest (538) + tsc clean + keel green. Resolves issueSwitchOutageFalseSynced. NOTE: the underlying host-unresolvable condition (notes2.willweatherholtz.com) is the owner's network/server to diagnose — the client's job is the honest status, which this restores."; }
        part switchAbortOnOutageDoDR1 : TestResult { :>> id = "a24e3e51-bb65-44a9-a602-62f36f821786"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1608366"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to switchAbortOnOutage;
        // ===== Sprint connectPhaseNoOptimisticFlip (2026-08-02) — 1.11.5: FIELD BUG (deeper layer). After the
        // 1.11.4 abort, the card STILL read 'Synced (polling)' during the failing connect attempts. =====
        action connectPhaseNoOptimisticFlip;
        verification connectPhaseNoOptimisticFlipDoD : Test { :>> id = "8884b3ca-21ad-47e7-bcc0-5e77f54fa6e8"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.5. Follow-up to switchAbortOnOutage on the owner's log: the switch now correctly ABORTED on the DNS outage (connect FAILED -> retrying in 3s), but the card STILL read 'Synced (polling)' during the failing ~30s connect attempts. Root cause, one FSM layer deeper: markReconciling() optimistically flipped connecting/disconnected -> reconciling (-> phase 'syncing') the moment the health check passed, BEFORE the initial reconcile; when that reconcile transferred NOTHING (failing on DNS), syncPending stayed 0 and effectivePhase collapsed syncing-0-pending -> idle -> a FALSE 'Synced (polling)' for the whole attempt. A normal POLL never had this — it doesn't pre-flip (beginReconcile escalates idle->reconciling only on real work). FIX: make connect behave like a poll — REMOVED markReconciling; broadened beginReconcile to escalate from idle OR an in-flight connect (connecting/disconnected); onProgress(pending>0) now calls it too. So the initial reconcile shows 'Connecting…' and becomes 'Syncing… N' ONLY while actually transferring — a failing/empty connect stays 'Connecting…'/'Reconnecting…' and can NEVER collapse to a false 'Synced'; beginReconcile is now the single door into 'reconciling'. No events lost (path/remote during connect still queue + process after connect). Spec (updated): docs/superpowers/specs/2026-08-02-status-display-pure-projection-design.md. Guards: syncengine.test 'the initial reconcile shows Connecting until it has real work, then Syncing' + 'a connect whose initial reconcile transfers NOTHING never shows a false syncing/idle' + 'a retry that reaches the server upgrades to syncing when it finds work'. DoD: full client vitest (538) + tsc clean + keel green. Resolves issueConnectFalseSyncedDuringInitialReconcile."; }
        part connectPhaseNoOptimisticFlipDoDR1 : TestResult { :>> id = "8c8c39ab-03d2-4ffd-ace5-7b14fa87454e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "08438fa"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to connectPhaseNoOptimisticFlip;
        // ===== Sprint switchReportsProgress (2026-08-02) — 1.11.6: FIELD BUG. A vault switch reported no
        // progress, so on 1.11.5 it sat on a static 'Connecting…' and read as HUNG. =====
        action switchReportsProgress;
        verification switchReportsProgressDoD : Test { :>> id = "7fd0d646-4414-4917-9c1c-46c3b5a8c93f"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.6. Follow-up to connectPhaseNoOptimisticFlip on the owner's log ('hung on connecting?'): on 1.11.5 the card honestly showed 'Connecting…' during the initial reconcile, but a vault SWITCH (upload/download) reports NO onProgress — so syncPending stayed 0, there was no 'Syncing… N' and no state escalation, and it sat on a STATIC 'Connecting…' the whole time (looked hung during a long upload). The normal reconcile (reconcileAll) reports onProgress; switchTo did not. FIX: switchDownload + switchUpload now report onProgress like reconcileAll — the full count up front, decrementing to 0 as each file transfers — which drives the 'N pending' detail AND (via main's onProgress -> beginReconcile) escalates the status to 'Syncing…'. So an active switch shows 'Syncing… N pending' that DECREASES (clearly working), a stalled one shows a stuck count, and a whole-server outage still aborts to 'Reconnecting…' (switchAbortOnOutage). merge already routed through reconcileAll (had progress). Guards: reconcile.test 'upload reports progress (full count -> 0)' + 'download reports progress (full count -> 0)'. DoD: full client vitest (540) + tsc clean + keel green. Resolves issueSwitchNoProgressLooksHung."; }
        part switchReportsProgressDoDR1 : TestResult { :>> id = "30634ebc-b184-4804-9774-0ad7b096404a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "7981610"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to switchReportsProgress;
        // ===== Sprint resumeReattemptsConnection (2026-08-02) — 1.11.7: FIELD BUG. On mobile, a failed
        // connection didn't re-attempt on resume (suspended backoff timer + a dropped remote event). =====
        action resumeReattemptsConnection;
        verification resumeReattemptsConnectionDoD : Test { :>> id = "784b9237-6d07-476e-8919-b15e2683a103"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.7. Owner (mobile): 'url works fine… is it rechecking though? I don't see it reattempt.' It wasn't. Root cause (mobile context-switching): (1) the backoff reconnect timer is window.setTimeout, which mobile SUSPENDS while backgrounded, so a pending retry sits paused; (2) onResume enqueued a `remote` event, which the engine DROPS while disconnected (it ignores work until connected). So foregrounding after a failed connect did nothing to re-attempt — it looked stuck with nothing in the log. FIX: onResume checks engine.getState(); if DISCONNECTED, it cancels the stale (paused) backoff timer and enqueues a fresh `connect` immediately (re-probing the now-available network/DNS), and LOGS 'app resumed — re-checking the connection' so the recheck is VISIBLE; if connected it re-assesses (reconcile) as before; 'off' (user-disconnected) is left alone. So every foreground promptly rechecks instead of waiting on a suspended timer. Guard: plugin-wiring 'mobile resume RE-ATTEMPTS a failed connection (not a dropped remote)'. DoD: full client vitest (541) + tsc clean + keel green. Resolves issueMobileResumeNoReattempt. NOTE: the owner confirmed the server URL works — this closes the mobile resume-recheck gap; a genuinely-unreachable server still shows honest 'Reconnecting…'."; }
        part resumeReattemptsConnectionDoDR1 : TestResult { :>> id = "d4b8725a-14a9-4521-9bfa-6fdde360c4db"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "777f586"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to resumeReattemptsConnection;
        // ===== Sprint switchUploadProbeGuard (2026-08-02) — 1.11.8: an L-1 data-loss bug FOUND by an STPA-UCA
        // hunt (not the field) — the upload switch tombstoned a remote file on a false-absent io.list(). =====
        action switchUploadProbeGuard;
        verification switchUploadProbeGuardDoD : Test { :>> id = "27eba8dd-fdd9-473f-b21c-336019865532"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.8 (DATA-INTEGRITY, L-1). Found by an STPA-UCA hunt on the delete/overwrite control actions (NOT a field report): switchUpload's remote-drop loop issued delete-remote (→ a server tombstone → delete-local on EVERY peer) for any path missing from the switch's SINGLE io.list() snapshot, with NO probePresence re-probe and NO bulk guard. io.list() is fallible (an un-hydrated cloud placeholder, a dir that fails to enumerate, an OS/AV lock transiently omits a STILL-PRESENT file); on an 'upload' switch that file is then never pushed AND tombstoned server-side → peers delete their real copy (L-1). This was the ONE delete path that trusted the raw listing — reconcileOne + reconcileDelta re-probe (probePresence) and switchDownload's local-mirror is bulk-ratio-guarded; switchUpload had neither, an asymmetry the codebase's own issueFalseAbsenceDelete guard exists to prevent. FIX: gate the remote-drop with probePresence — present OR indeterminate ⇒ KEEP on the server (only a definitive local absence tombstones), mirroring reconcileOne's delete-remote. Guard (fail-first proven — RED without the probe: keep.md tombstoned; GREEN with it): reconcile.test 'upload switch does NOT tombstone a remote file that io.list() FALSELY omits'. DoD: full client vitest (553) + tsc clean + keel green. Resolves issueSwitchUploadFalseAbsenceDelete. Realizes the SR for UCA-6 on the switch path (STPA S-17)."; }
        part switchUploadProbeGuardDoDR1 : TestResult { :>> id = "590dd37c-9fe5-439c-aceb-35bf4db7b30e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e1a9d21"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to switchUploadProbeGuard;
        // Backlog stub (STPA-hunt finding 2, owner-decision) — untrusted CSS from a shared vault is applied
        // with only a restart notice, no trust warning + no private-vault gate (unlike plugin code). NOT started.
        action cssTrustGate;
        verification cssTrustGateDoD : Test { :>> id = "0a214c17-b7f8-44d7-8f05-53223201d333"; :>> method = VerificationMethod::test; :>> procedureText = "DONE (1.11.9 @059830d). The second STPA-hunt finding (L-3, Medium): flushConfigReload classified synced themes/snippets/appearance CSS as 'will apply after restart' (a bare Notice) on the premise 'CSS never auto-applied' — but the plugin WRITES the CSS to disk during reconcile and Obsidian hot-reloads an ENABLED snippet/theme with no restart; CSS in the un-CSP'd renderer enables exfil (background:url) + phishing. UCA-7 named CSS but its mitigation SR-5 gated only plugin CODE. OWNER DECISION: the owner directed 'close css gap' (gate, not accept-by-parity). FIX: flushConfigReload handles CSS on its own branch with a FRESH privacy re-check (like the hot-load gate) — a SHARED/shareable vault gets a TRUST WARNING ('CSS arrived via sync from a shared vault … REVIEW it and remove anything from a source you don't trust'), a provably-PRIVATE vault a plain notice; the stale 'never auto-applied' comment corrected; the test-harness Notice records messages so the warning is asserted. Guard: plugin-wiring 'synced CSS from a SHARED vault warns … PRIVATE plain'. DoD: full client vitest (554) + tsc clean + keel green. Resolves issueUntrustedCssApplied."; }
        part cssTrustGateDoDR1 : TestResult { :>> id = "7857965c-e4f9-4f7e-9d49-a077e74f2572"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "059830d"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        #Covers dependency from sittingReview20260802 to cssTrustGate;
        // ===== Sprint deleteRemoteCasGuard (2026-08-02) — an L-1 LOST-UPDATE (server) FOUND by an STPA-UCA
        // hunt on the delete/overwrite control actions; the owner chose CAS-guard over accept-authoritative. =====
        action deleteRemoteCasGuard;
        verification deleteRemoteCasGuardDoD : Test { :>> id = "4c8a1f20-3b6d-4e91-a7c2-9d05e8f13b46"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.10 (DATA-INTEGRITY, L-1) — client + SERVER (the self-hosted server image MUST be redeployed for the guard to take effect; both sides are backward-compatible so either can update first). STPA-UCA hunt on the server delete control action: Vault::commit CAS-guards optimistic concurrency (expected_version) but Vault::delete did NOT — a device on a STALE base could delete a file another device just edited (A edits v5->v6; B, still at v5, deletes -> tombstone v7), and the editor pulls the tombstone + silently loses its edit FLEET-WIDE (a lost update, no conflict marker) — the exact class commit's CAS stops; a readWrite grantee could weaponize it. OWNER DECISION (AskUserQuestion 2026-08-02): CAS-guard delete, symmetric with commit, over accept-authoritative (recorded in deleteRemoteCasGuardChoice). FIX: server Vault::delete_checked(path, expected_version) mirrors commit's CAS (stale -> AlreadyExists -> 409); delete_file parses expected_version + maps the conflict to 409; the authoritative Vault::delete(path) wrapper (None) still always wins for deliberate deletes + tests. Client transport.deleteFile(path, expectedVersion?) wires the query param + maps 409 -> CommitConflictError; the reconcile deleteRemote effect carries the based-on remote version + the shell sends it; user-gesture / adjudication / switch deletes OMIT it. On a 409 the client re-reconciles and — because decide() keys on hashes — remote-advanced-since-base reads as edit-wins-pull, RESURRECTING the edit (never lost). Backward-compatible both ways (old client omits the field; old server ignores the unknown query param). Guards (fail-first — without the guard the stale delete clobbers): server cargo vault::tests::delete_cas_rejects_a_stale_delete_that_would_clobber_a_newer_commit + authoritative_delete_always_wins_and_absent_delete_is_a_noop; client reconcile.test 'delete-remote CAS ... passes the based-on remote version' + '... a stale delete 409s and the peer's concurrent edit is resurrected (edit-wins-pull), never lost'; finalize.test asserts the deleteRemote effect carries the version. DoD: full server cargo test (all suites 0 failed) + full client vitest (186) + tsc clean + keel validate + guard green. Resolves issueDeleteNoCasLostUpdate. Realizes the SR for the delete control action (STPA S-18)."; }
        part deleteRemoteCasGuardDoDR1 : TestResult { :>> id = "5e9b2a31-4c7e-4f02-b8d3-ae16f9024c57"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f141a3a"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        // The owner's DESIGN CHOICE (confirmation) — CAS-guard over accept-authoritative; the evidence is their explicit pick.
        verification deleteRemoteCasGuardChoice : Test { :>> id = "6f0c3b42-5d8f-4013-c9e4-bf27a0135d68"; :>> method = VerificationMethod::confirmation; :>> procedureText = "The owner was shown the VERIFIED fork — DELETE has no CAS, so a stale delete silently discards a concurrent edit, while COMMIT already guards exactly this — and chose 'CAS-guard delete (like commit)' over 'Accept delete-authoritative' and 'Let me see both diffs first', via an explicit AskUserQuestion on 2026-08-02. This records ONLY that design-approach choice (their word is the evidence, D0016); it is NOT acceptance of the shipped RESULT — the per-sitting review (sittingReview20260802b) stays open for the owner's review of 1.11.10."; }
        part deleteRemoteCasGuardChoiceR1 : TestResult { :>> id = "7a1d4c53-6e90-4124-daf5-c038b1246e79"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f141a3a"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "wweatherholtz"; }
        #Covers dependency from sittingReview20260802b to deleteRemoteCasGuard;
        // Backlog stub (STPA server-hunt LOW finding, issueMirrorWriteNotSelfHealed) — a failed bind-mount mirror
        // write isn't self-healed by a later idempotent commit retry. NOT data loss (chunk store authoritative);
        // niche (direct host-fs editing). NOT started — honestly-incomplete backlog (non-blocking, D0098).
        action mirrorWriteSelfHealBacklog;
        verification mirrorWriteSelfHealBacklogDoD : Test { :>> id = "a1b2c3d4-1700-4a10-9b20-d1700c0de017"; :>> method = VerificationMethod::test; :>> procedureText = "Ships with 1.17.0 (server; redeploy). A failed best-effort bind-mount mirror write is now REPAIRED by a later idempotent re-commit: Vault::commit's same-content short-circuit re-attempts write_mirror when the on-disk mirror is absent or its size differs (gated on cheap fs::metadata — write_mirror is atomic temp+fsync+rename, so a size match is a reliable already-healed signal; avoids a full-file read per re-commit, critique #2). NOT data loss (the chunk store is authoritative + serves get_chunk); niche (a user editing on the host FS via the bind mount). Guard: vault::tests::idempotent_recommit_self_heals_a_missing_mirror + clippy -D warnings. Resolves issueMirrorWriteNotSelfHealed."; }
        part mirrorWriteSelfHealBacklogDoDR1 : TestResult { :>> id = "a1b2c3d4-1700-4a10-9b20-d1700c0de018"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b997a63"; :>> judgedAt = "2026-08-05"; :>> judgedBy = "claudeOpus"; }
        // ===== Sprint removeDiagnoseButton (2026-08-02) — 1.11.11: remove the misleading 'Diagnose' button
        // (L-5 false all-clear); the honest FSM-projected status card is the single source of truth. =====
        action removeDiagnoseButton;
        verification removeDiagnoseButtonDoD : Test { :>> id = "9d3f0a51-6c8e-4b72-a1d4-0e5f28b39c60"; :>> method = VerificationMethod::test; :>> procedureText = "Ships PATCH 1.11.11 (UX / L-5). Owner-reported: 'does diagnose actually do much? always says everything is fine even if it's not working.' HttpTransport.diagnose probed only the CONNECTION chain (reachable/version/auth/vault/degraded) via out-of-band HTTP and returned 'All good' whenever those five links were healthy — NEVER consulting the live sync engine, so it was blind to sync non-convergence (stalled/off engine, pending not draining, a file looping, a wedged FSM) and gave a false all-clear in exactly the stuck-but-pipe-fine case the user clicks it for. Analysis: the honest status card (a pure FSM projection, built this sitting) ALREADY surfaces every actionable cause diagnose gave, via connstate.blockedTip (version mismatch / sign-in / session / MFA / vault-gone / access-removed / degraded), derived from REAL failures — so diagnose was a redundant SECOND source of truth whose only distinctive behavior was the misleading all-clear (the dual-source anti-pattern). OWNER DECISION ('consider just removing'): REMOVE the Diagnose button + its whole chain — settings.ts button+runDiagnosis, main.ts diagnoseConnection, transport.ts HttpTransport.diagnose + the Diagnosis/DiagnosisLayer types, the transport.test diagnose ladder suites, the ui-dom-harness mock — leaving the honest status line as the single source (it cannot give a false all-clear, being a pure projection). The separate 'Diagnostics' group (Show sync log / Copy debug info) is untouched; tryJson stays (shared). Guard: transport.test green with the diagnose suites removed (no dead reference); tsc clean proves no orphaned import (CLIENT_API_VERSION import dropped). DoD: full client vitest + tsc clean + esbuild build clean + keel validate + guard green. Resolves issueDiagnoseFalseAllClear. Relates to H-9 (reported!=actual -> L-5); no new STPA element — removing the redundant feedback channel collapses it into the FSM-projected card already covered by S-13..S-15."; }
        part removeDiagnoseButtonDoDR1 : TestResult { :>> id = "ae2c4f60-7d19-4083-b5e6-1f307a248d71"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "64708b4"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "claudeOpus"; }
        // The owner's DESIGN CHOICE (confirmation) — remove over upgrade; their word is the evidence.
        verification removeDiagnoseButtonChoice : Test { :>> id = "bf3d5071-8e2a-4194-c6f7-20418b359e82"; :>> method = VerificationMethod::confirmation; :>> procedureText = "The owner reported the diagnostic's false all-clear ('always says everything is fine even if it's not working') and, when offered a heavier live-state+active-probe upgrade, redirected: 'might be totally unnecessary. consider just removing.' Shown the evidence that the honest status card already gives every actionable cause diagnose provided, the owner's direction was to REMOVE. This records ONLY that design-approach choice (their word is the evidence, D0016); it is NOT acceptance of the shipped RESULT — sittingReview20260802b covers the owner's review of 1.11.11."; }
        part removeDiagnoseButtonChoiceR1 : TestResult { :>> id = "c04e6182-9f3b-42a5-d708-31529c460f93"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "64708b4"; :>> judgedAt = "2026-08-02"; :>> judgedBy = "wweatherholtz"; }
